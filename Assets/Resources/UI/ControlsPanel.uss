.root {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
}

.panel {
    display: none;
    width: 420px;
    padding: 24px 28px;
    background-color: rgba(12, 18, 24, 0.92);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(180, 200, 210, 0.25);
}

.panel--open {
    display: flex;
}

.title {
    font-size: 28px;
    color: rgb(235, 242, 245);
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.subtitle {
    font-size: 13px;
    color: rgb(150, 165, 175);
    margin-bottom: 18px;
}

.rows {
    flex-direction: column;
}

.row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 8px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.08);
}

.action {
    font-size: 15px;
    color: rgb(210, 220, 225);
}

.key {
    font-size: 14px;
    color: rgb(120, 200, 180);
    -unity-font-style: bold;
    margin-left: 16px;
}

.footer {
    margin-top: 16px;
    font-size: 12px;
    color: rgb(130, 145, 155);
}

.close-btn {
    margin-top: 18px;
    height: 36px;
    background-color: rgb(40, 90, 85);
    color: rgb(235, 245, 242);
    border-radius: 4px;
    border-width: 0;
}

.close-btn:hover {
    background-color: rgb(55, 120, 110);
}

.hint {
    position: absolute;
    right: 16px;
    bottom: 16px;
    font-size: 13px;
    color: rgba(220, 230, 235, 0.75);
    background-color: rgba(0, 0, 0, 0.35);
    padding: 6px 10px;
    border-radius: 4px;
}

.hint--hidden {
    display: none;
}
